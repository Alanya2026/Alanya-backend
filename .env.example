# MySQL pool size (default 10). After message:send SQL reductions, 15–20 is
# reasonable under concurrent load — tune from metrics.
# DB_POOL_SIZE=15  

# App 
APP_NAME=Alanya
APP_VERSION=1.0.0
APP_DESCRIPTION=Backend for Alanya chat application
APP_AUTHOR=Alanya
APP_LICENSE=MIT
LOGO_URL=https://www.alanya237.com/uploads/images/alanya-officiel.png

# Avatar imposé aux comptes officiels (account_type = 2). À défaut, LOGO_URL.
OFFICIAL_ACCOUNT_AVATAR_URL=https://www.alanya237.com/uploads/images/alanya-officiel.png

AVATAR_DEFAULT_MALE=https://www.alanya237.com/uploads/images/default_avatar_male.png
AVATAR_DEFAULT_FEMALE=https://www.alanya237.com/uploads/images/default_avatar_female.png


# # MySQL Configuration
# DB_HOST=163.123.183.89
# DB_PORT=17705
# DB_NAME=alanyaBD2026
# DB_USER=trump
# DB_PASSWORD= 

# Server Configuration
PORT=3000 
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=

# Chiffrement des codes de récupération de compte (users.recovery_code_enc).
# 32 octets en base64 : openssl rand -base64 32
# Si absente, la clé est dérivée de JWT_SECRET et un avertissement est logué.

# ⚠ CHANGER CETTE VALEUR (ou JWT_SECRET si l'on est sur le repli) rend TOUS les
# codes de récupération déjà émis indéchiffrables : leurs propriétaires perdent
# silencieusement leur seule voie de retour s'ils n'ont pas d'e-mail.
# RECOVERY_CODE_KEY=

# Plafond d'inscriptions réussies par IP (POST /api/auth/register).
# Seuls les comptes créés (2xx) consomment le quota ; les échecs de validation non.
# REGISTER_MAX_PER_IP=3
# REGISTER_WINDOW_MS=86400000

# Firebase Service Account (JSON stringified)
FIREBASE_SERVICE_ACCOUNT=

# FCM - Uses Firebase Admin SDK HTTP v1 (via FIREBASE_SERVICE_ACCOUNT)
# No FCM_SERVER_KEY needed (old method, less secure)

# Phase 4 — MessagingStyle Android (FCM data-only pour messages)
# Doit être true en même temps que talkyNotificationNativeV2=true côté app.
NOTIFICATION_ANDROID_NATIVE_V2=true

# Worker de file de diffusion (broadcast_prepare / broadcast_push).
# Obligatoire sur au moins une instance : sans lui, les diffusions restent en
# « Préparation… 0 % » (job en attente dans job_queue, jamais consommé).
# BROADCAST_WORKER_ENABLED=true

# APNs VoIP (Phase 6.2) — clé .p8 Apple Developer, jamais committer le secret
# IOS_VOIP_V2=true
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.example.talkyFlutter
# APNS_KEY_PATH=/path/to/AuthKey_XXXX.p8
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_PRODUCTION=false
# APNS_VOIP_TTL_SEC=60

# TURN / ICE (GET /api/turn/credentials)
# auth: "static" = username/credential du JSON ; "auth": "hmac" = credentials éphémères via TURN_SECRET
# TURN_SECRET=
# TURN_TTL_SEC=86400
# TURN_SERVERS=[{"urls":["turn:example.com:3478"],"username":"user","credential":"pass","auth":"static"},{"urls":["stun:coturn.example:3478","turn:coturn.example:3478?transport=udp","turns:coturn.example:5349?transport=tcp"],"auth":"hmac"}]

# ── Volet QR : page d'accueil publique et liens universels ────────────
# Base des URL encodées dans les QR (identité et connexion). Doit correspondre
# au domaine réellement servi, sinon les codes déjà en circulation cassent.
# QR_BASE_URL=https://www.alanya237.com

# Schéma applicatif du bouton « Ouvrir dans Alanya » de la page d'accueil.
# Fonctionne sans aucun certificat, contrairement aux liens universels.
# QR_APP_SCHEME=alanya

# Liens de téléchargement affichés à qui n'a pas encore l'app (optionnels :
# les boutons disparaissent si la variable est vide).
# QR_PLAY_STORE_URL=
# QR_APP_STORE_URL=

# ── Android App Links (ouverture directe de l'app depuis un lien https) ──
# Empreintes SHA-256 du ou des certificats de signature, séparées par des
# virgules. Sans elles, /.well-known/assetlinks.json renvoie 404 et Android
# ouvre le navigateur — dégradation, pas panne : la page propose le bouton
# en schéma applicatif.
#
# Empreinte de la clé DEBUG (celle qui signe aussi les builds release
# actuels, cf. signingConfigs.getByName("debug") dans app/build.gradle.kts) :
#   keytool -list -v -alias androiddebugkey \
#     -keystore ~/.android/debug.keystore -storepass android -keypass android
#
# ⚠ À LA PUBLICATION SUR LE PLAY STORE : Google re-signe l'application. Il faut
# AJOUTER (sans retirer celle-ci) l'empreinte du Play App Signing, relevée dans
# Console Play → Configuration → Intégrité de l'application → Certificat de la
# clé de signature de l'app → SHA-256. Tant que ce n'est pas fait, les liens
# https ouvriront le navigateur sur les installations venues du Store.
# QR_ANDROID_SHA256=2A:A0:3C:ED:2F:5F:C2:53:70:29:D7:F6:8C:C2:35:F5:4C:17:B2:82:FB:99:54:2C:2E:62:AE:37:A1:9D:C3:0D
# QR_ANDROID_PACKAGE=com.alanya237.alanya

# ── iOS Universal Links (non configurés) ─────────────────────────────
# Team ID Apple, 10 caractères : developer.apple.com → Membership details.
# Tant qu'il est vide, /.well-known/apple-app-site-association renvoie 404 et
# iOS s'en tient au schéma alanya:// — l'app s'ouvre par le bouton de la page.
# QR_IOS_TEAM_ID=
# QR_IOS_BUNDLE_ID=com.alanya237.alanya

# ── Trajets de confiance (volet 7) ────────────────────────────────────
# Le worker de jobs porte les échéances : sans lui, aucune alerte ne part et
# POST /api/trips refuse de créer un trajet (503 JOB_WORKER_DOWN).
# JOB_WORKER_ENABLED remplace BROADCAST_WORKER_ENABLED, qui reste accepté.
JOB_WORKER_ENABLED=true

# Cadence GPS — servie au client, réglable sans publier l'application.
# Filtre nominal : dépend du type (taxi vs à pied). Approche / alerte inchangés.
TRIP_FILTER_M_TAXI=450
TRIP_FILTER_M_WALK=75
# Repli historique si TRIP_FILTER_M_WALK est absent (anciens déploiements).
# TRIP_FILTER_M_NOMINAL=75
TRIP_FLOOR_S_NOMINAL=15
TRIP_BEAT_S_NOMINAL=90
TRIP_FILTER_M_APPROACH=30
TRIP_FLOOR_S_APPROACH=8
TRIP_BEAT_S_APPROACH=30
# ⚠ Le régime d'alerte est le seul où la précision sert vraiment : ne pas relâcher.
TRIP_FILTER_M_ALERT=15
TRIP_FLOOR_S_ALERT=5
TRIP_BEAT_S_ALERT=15

# Décimation serveur et péremption.
TRIP_BROADCAST_MIN_S=5
TRIP_PERSIST_MIN_S=30
TRIP_STALE_FACTOR=3
TRIP_MAX_ACCURACY_M=100

# Contrat — figé dans le trajet à sa création, ne change jamais un trajet parti.
# Sous 5 min de grâce, chaque embouteillage devient une alerte et le cercle
# apprend à ne plus les ouvrir.
TRIP_GRACE_MIN=10
TRIP_MAX_DURATION_H=12
# Rayon d'arrivée GPS (m). Figé à la création ; 100 = compromis urbain vs 50/150.
TRIP_DEST_RADIUS_M=100
# Rester dans le rayon N secondes + vitesse max pour poser la question d'arrivée.
TRIP_ARRIVAL_HYSTERESIS_S=60
TRIP_ARRIVAL_MAX_SPEED_KMH=15
TRIP_ETA_SOON_MIN=5
TRIP_NO_WATCHER_MIN=5
TRIP_LOW_BATTERY_PCT=15
# Sous ce seuil : alerte batterie critique (distincte de TRIP_LOW_BATTERY_PCT).
TRIP_CRITICAL_BATTERY_PCT=5

# Rétention. La trace s'efface, le fait reste.
# 720 h = 30 jours. Purge nocturne automatique, purge manuelle dans l'admin.
TRIP_POINTS_RETENTION_H=720
TRIP_POINTS_INCIDENT_D=30
TRIP_RETENTION_MONTHS=12
# Verrou anti-coercition : un trajet clos sur alerte n'est pas supprimable avant.
TRIP_INCIDENT_LOCK_D=30
# Plafond de SOS par fenêtre glissante de 24 h (fatigue d'alerte du cercle).
TRIP_SOS_MAX_24H=10

# ── Fond de carte ─────────────────────────────────────────────────────
# Source des tuiles, SERVIE au client (GET /api/map/tiles) et non compilée dans
# l'application : changer de fournisseur ne doit pas exiger une publication sur
# les magasins. Voir docs/exploitation/tuiles.md côté Talky.
#
# ⚠ Le défaut, tile.openstreetmap.org, est un défaut de DÉVELOPPEMENT. Il tourne
# sur les ressources données à la fondation OSM et sa politique n'autorise qu'un
# usage léger ; un suivi de trajet le dépasse largement.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap
MAP_TILE_MAX_ZOOM=19
# Durée de conservation d'une tuile sur l'appareil.
MAP_TILE_CACHE_DAYS=30

# ── Redis (adapter Socket.IO + état d'appels/réunions partagé) ─────────
#
# Absent : repli mémoire, comportement mono-instance identique à avant.
# Défini : le serveur DOIT pouvoir s'y connecter au démarrage, sinon il
# refuse de démarrer (plutôt que de tourner en croyant émettre cluster-wide).
#
# ⚠ Le mot de passe doit être ENCODÉ POUR URL. `openssl rand -base64 32`
# produit des `+`, `/` et `=` : un `/` non encodé fait échouer la connexion
# sur un simple « Invalid URL », sans autre explication.
#   / → %2F      + → %2B      = → %3D
# Pour construire l'URL sans se tromper :
#   node -e 'console.log("redis://:"+encodeURIComponent(process.argv[1])+"@127.0.0.1:6379")' 'MOT_DE_PASSE'
#
# REDIS_URL=redis://:MOT_DE_PASSE_ENCODE@127.0.0.1:6379

# ── Sentry (rapport d'erreurs backend) ─────────────────────────────────
#
# Absent : le SDK n'est pas initialisé, rien n'est envoyé. C'est l'état
# attendu en développement local et en CI — aucun réglage à poser pour
# éviter de polluer le projet Sentry avec des erreurs de test.
#
# Défini : chaque exception non capturée, promesse rejetée et erreur de
# route part chez Sentry, expurgée. Ne partent JAMAIS : le corps des
# requêtes (c'est là que voyage le texte des messages), les en-têtes
# d'authentification, les cookies, la chaîne de requête, et tout champ
# nommé password/token/phone/email/content/... où qu'il se trouve dans
# l'événement. Voir src/config/sentry.js.
#
# SENTRY_DSN=https://<cle>@<organisation>.ingest.sentry.io/<projet>
#
# La version déployée est lue toute seule dans .git (le déploiement fait un
# `git reset --hard`), pour ranger chaque erreur sous le commit qui l'a
# introduite. À ne définir que si le serveur tourne un jour sans dépôt git :
# SENTRY_RELEASE=

# ── Assistance éditoriale (OpenRouter) ─────────────────────────────────
#
# Traduit et relit le contenu OFFICIEL depuis le panneau d'administration :
# message de bienvenue, diffusions, statuts, libellés de boutons. Jamais un
# message d'utilisateur — la traduction des conversations reste on-device.
#
# Absent : la fonctionnalité est simplement indisponible. `GET /admin/ai/status`
# répond `enabled: false` et l'éditeur n'affiche aucun bouton. Rien d'autre ne
# change dans le panneau.
#
# OPENROUTER_API_KEY=sk-or-v1-...

# Modèle utilisé. En changer ne demande aucun déploiement de code — le
# catalogue est listable sur https://openrouter.ai/api/v1/models
# Par défaut : google/gemini-2.5-flash (bon compromis fr/en/zh, peu coûteux).
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Facultatifs.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://www.alanya237.com
# OPENROUTER_TIMEOUT_MS=30000
# Garde-fou contre la boucle, pas contre l'abus : les appelants sont
# authentifiés et gardés par la permission `ai.editorial`.
# AI_EDITORIAL_MAX_PER_MIN=20

# ── Abonnement Alanya Plus ─────────────────────────────────────────────
#
# Fournisseur de paiement actif. `simulated` (défaut) imite un agrégateur :
# aucun argent n'est encaissé. En production, l'interrupteur du payant refuse
# de s'activer tant que c'est le simulateur.
# PAYMENT_PROVIDER=simulated
#
# Secret de signature des réponses du simulateur (webhook interne).
# PAYMENT_SIMULATOR_SECRET=
#
# Comptes testeurs : identifiants alanyaID séparés par des virgules. Ils voient
# la phase payante même interrupteur éteint, et peuvent acheter — c'est ainsi
# qu'on éprouve le parcours en production sans toucher personne d'autre.
# BILLING_TEST_USERS=
#
# Régime « essai » (v2, billing_settings.model = 2) : les codes d'activation
# sont signés (HMAC-SHA256) par ce secret. Obligatoire pour activer le payant
# dans ce régime ; 32 caractères au moins (openssl rand -base64 48). Le
# changer rend INCONNUS tous les codes déjà émis et non utilisés : à poser une
# fois, à ne jamais renouveler à la légère. Jamais dans git : seulement dans
# le .env du serveur (et une sauvegarde à part).
# ACTIVATION_CODE_SECRET=

# ── Vérification d'identité (la coche) ─────────────────────────────────
#
# Coffre à pièces : la pièce d'identité et le selfie y sont chiffrés
# (AES-256-GCM), un fichier par pièce. Sans ces deux variables, le dépôt
# répond 503 VERIFICATION_UNAVAILABLE.
#
# VAULT_DIR : chemin ABSOLU, hors de uploads/ (servi en statique — le coffre y
# est refusé). Propriétaire : l'utilisateur du processus Node, droits 700.
# VAULT_DIR=/var/lib/alanya/coffre
#
# VAULT_KEY : 32 octets en base64 (openssl rand -base64 32). La changer rend
# illisibles toutes les pièces déjà déposées.
# VAULT_KEY=

# ─── Conservation des médias ───
# Valeurs par défaut ; l'espace super-admin des purges (purge « Médias
# expirés ») les surcharge sans redémarrage.
# Durée standard, en jours (1 à 365).
# MEDIA_RETENTION_DAYS=30
# Durée Alanya Plus, en jours (1 à 365 : la règle de cycle de vie du bucket
# masque `media/` à 366 jours). Ne s'applique qu'en phase payante.
# MEDIA_PLUS_RETENTION_DAYS=365
# Au-delà de ce nombre de fichiers en une nuit (ou de trois fois la moyenne des
# dernières nuits), la purge automatique s'arrête sans rien supprimer.
# MEDIA_PURGE_ALERT_FLOOR=1000

# ─── Stockage des médias (Cloudflare R2 et Backblaze B2) ───
# OBLIGATOIRE : le serveur ne range ni ne sert plus aucun média sur son disque.
# Sans bucket privé complet (R2 ou, à défaut, Backblaze), tout envoi et toute
# lecture de média répondent 503.
# Conception : docs/conception/medias-backblaze.html et medias-buckets.html.

# Bucket privé des médias de discussion (`media/`), chez Cloudflare R2.
# R2_ENDPOINT : l'adresse « S3 API » du bucket (tableau de bord R2 › bucket ›
# Settings). Jeton de compte « Object Read & Write », limité à ce bucket.
# Tant qu'une de ces quatre variables manque, les médias de discussion restent
# dans le bucket privé de Backblaze ci-dessous.
R2_ENDPOINT=
R2_BUCKET=alanyaprivate
R2_KEY_ID=
R2_APP_KEY=
# À poser APRÈS `npm run migrate:private-r2 -- --apply` : avant, un média
# absent de R2 est encore cherché dans le bucket privé de Backblaze (et les
# suppressions visent les deux) ; après, Backblaze n'est plus consulté pour
# les médias de discussion.
MEDIA_PRIVATE_MIGRATED=false

# Backblaze B2 : point d'accès et région des buckets publics, et bucket privé
# d'origine (`B2_BUCKET`, `B2_KEY_ID`, `B2_APP_KEY` — à garder jusqu'à ce que
# MEDIA_PRIVATE_MIGRATED soit posé et l'ancien bucket vidé).
# Clé d'application limitée au bucket — jamais la clé principale du compte,
# qui ne fonctionne d'ailleurs pas avec l'API compatible S3.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=alanyaprivate
B2_KEY_ID=
B2_APP_KEY=
# Validité des liens signés, en secondes (lecture, envoi direct)
B2_DOWNLOAD_URL_TTL_S=3600
B2_UPLOAD_URL_TTL_S=900

# MEGA S4 — essai pour un futur coffre-fort, lu SEULEMENT par
# `npm run smoke:mega-s4` (le serveur ne s'en sert pas).
# MEGA_S4_REGION est facultatif : par défaut, le 2e mot du point d'accès.
MEGA_S4_ENDPOINT=s3.eu-luxembourg-1.megas4.com
MEGA_S4_BUCKET=
MEGA_S4_KEY_ID=
MEGA_S4_SECRET=

# Buckets publics (même région, même point d'accès). Conception :
# docs/conception/medias-buckets.html. Chacun sa clé d'application, limitée
# à lui. Tant qu'un bucket est incomplet (nom, clé ou secret manquant), ses
# fichiers restent dans le bucket privé, comme avant.
# Photos de profil et de groupe (`images/`).
B2_PROFILE_BUCKET=alanyaprofile
B2_PROFILE_KEY_ID=
B2_PROFILE_APP_KEY=
# Annonces du répondeur (`voicemail/`), sonneries importées (`ringtones/`),
# médias officiels des diffusions et de l'accueil (`official/`).
B2_PROFILEMEDIA_BUCKET=profilemedia
B2_PROFILEMEDIA_KEY_ID=
B2_PROFILEMEDIA_APP_KEY=
# À poser APRÈS `npm run migrate:public-buckets -- --apply` : les anciennes
# adresses `/uploads/images/…` et `/uploads/voicemail/…` sont alors
# redirigées vers le bucket public au lieu d'être lues dans le privé.
MEDIA_PUBLIC_MIGRATED=false
# Secret des adresses de sonneries importées : une longue chaîne aléatoire,
# à ne JAMAIS changer une fois posée (les adresses existantes en dépendent).
# Sans lui, les sonneries restent sur le téléphone, comme avant.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RINGTONE_KEY_SECRET=

# Courriels transactionnels (codes, avis de compte). Ordre d'essai : le premier
# qui accepte gagne, le suivant ne sert qu'en cas d'échec. `smtp` (ancien envoi
# Gmail, variables SMTP_*) reste possible : MAIL_PROVIDERS=smtp
MAIL_PROVIDERS=postmark,bird
# Doit appartenir à un domaine / expéditeur vérifié chez Postmark ET Bird.
MAIL_FROM=info@alanya.cloud
MAIL_FROM_NAME=Alanya
SUPPORT_EMAIL=support@alanya.cloud
# Postmark : jeton du serveur (Servers > <serveur> > API Tokens).
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POSTMARK_MESSAGE_STREAM=outbound
# Bird : clé d'API (bk_us1_… ou bk_eu1_…) ; la région suit la clé.
BIRD_API_KEY=bk_us1_xxxxxxxxxxxxxxxxxxxxxxxx
BIRD_REGION=us1
